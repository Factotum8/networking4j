# Copy to .env and fill in. Never commit the real .env.

# --- App server ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- LLM provider API keys (1Password CLI, not a Service Account) ---
# Individual/Families 1Password plans can't create Service Accounts, so
# these are `op://vault/item/field` references, not real keys. Launch the
# app via `op run --env-file=.env -- <command>` (see Makefile's `run` target)
# so the 1Password CLI substitutes the real value before the process starts
# — this app never talks to 1Password itself. Requires: `op` CLI installed,
# signed into the desktop app, and "Integrate with 1Password CLI" enabled
# under Settings -> Developer. A plain `pixi run uvicorn ...` (skipping
# `op run`) leaves these as literal `op://...` strings, which is fine for
# any endpoint except `/ai/*`.
CLAUDE_API_KEY=op://networking4j/claude-api-key/credential
CODEX_API_KEY=op://networking4j/codex-api-key/credential

# --- Networking defaults ---
STALE_CONTACT_DAYS_DEFAULT=60

# --- Stage 8: LLM provider (CLI/AI integration) ---
# claude or codex — picks which of the two API keys above is actually used.
# No fallback to the other one if this provider's key is missing.
LLM_PROVIDER=claude
LLM_MODEL_CLAUDE=claude-sonnet-4-5-20250929
LLM_MODEL_CODEX=gpt-5-codex

# --- CLI ---
API_BASE_URL=http://127.0.0.1:8000
