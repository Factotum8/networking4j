# Copy to .env and fill in. Never commit the real .env.

# --- App server ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- 1Password (Service Account) ---
# Create a Service Account scoped to a single vault holding the Claude/Codex
# API key items, then paste its token here (or export it in your shell —
# never commit a real token).
OP_SERVICE_ACCOUNT_TOKEN=
OP_VAULT=networking4j
OP_ITEM_CLAUDE_API_KEY=claude-api-key
OP_ITEM_CODEX_API_KEY=codex-api-key
OP_FIELD_CLAUDE_API_KEY=credential
OP_FIELD_CODEX_API_KEY=credential

# --- Networking defaults ---
STALE_CONTACT_DAYS_DEFAULT=60

# --- CLI ---
API_BASE_URL=http://127.0.0.1:8000
